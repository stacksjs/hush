{
  "name": "hushapp",
  "type": "module",
  "version": "0.2.2",
  "description": "A simple app to block notifications when you're screen sharing.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/hush#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/hush.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/hush/issues"
  },
  "keywords": [
    "macos",
    "app",
    "screen",
    "sharing",
    "do",
    "not",
    "disturb",
    "focus",
    "stacks",
    "stx",
    "craft"
  ],
  "files": [
    "README.md",
    "dist/*.dmg"
  ],
  "scripts": {
    "dev": "./buddy dev",
    "build": "./buddy build",
    "package": "./buddy package",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "format": "bunx --bun pickier . --format",
    "format:fix": "bunx --bun pickier . --format --write",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "changelog": "bunx --bun @stacksjs/logsmith --verbose",
    "changelog:generate": "bunx --bun @stacksjs/logsmith --output CHANGELOG.md",
    "release": "bunx --bun @stacksjs/bumpx prompt --recursive --commit --tag --push --yes",
    "release:patch": "bunx --bun @stacksjs/bumpx patch --recursive --commit --tag --push --yes",
    "release:minor": "bunx --bun @stacksjs/bumpx minor --recursive --commit --tag --push --yes",
    "release:major": "bunx --bun @stacksjs/bumpx major --recursive --commit --tag --push --yes",
    "test": "bun run test:unit",
    "typecheck": "bun --bun tsc --noEmit",
    "test:unit": "bun test test/preferences.test.ts test/policy.test.ts test/controller.test.ts test/statistics.test.ts test/native-sharing.test.ts test/native-artifact.test.ts --preload ./test-utils/dom.ts",
    "test:e2e": "bun test test/e2e.test.ts --preload ./test-utils/dom.ts",
    "test:native": "bun scripts/test-native.ts",
    "test:native:app": "bun scripts/test-native.ts --launch-services --background-ms=65000",
    "test:compatibility": "bun scripts/verify-compatibility.ts",
    "verify": "bun run build && bun run typecheck && bun run test:unit && bun run test:e2e && bun run test:native && bun run test:native:app",
    "predev": "bun scripts/setup-craft.ts",
    "prebuild": "bun scripts/setup-craft.ts",
    "prepackage": "bun scripts/setup-craft.ts"
  },
  "dependencies": {
    "@stacksjs/stx": "^0.2.695"
  },
  "devDependencies": {
    "better-dx": "^0.2.38",
    "very-happy-dom": "^0.4.0"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md,stx}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  },
  "stacks": {
    "type": "native"
  }
}
