<script server>
import { FOCUS_OFF_SHORTCUT, FOCUS_ON_SHORTCUT } from './core/preferences'

const appName = 'Hush'
const tagline = 'Silences your Mac while you share your screen.'

const setupSteps = [
  `Open Shortcuts and create a shortcut named “${FOCUS_ON_SHORTCUT}”.`,
  'Add the “Set Focus” action, set it to turn Do Not Disturb on.',
  `Create a second shortcut named “${FOCUS_OFF_SHORTCUT}” that turns it off.`,
]

const preferenceRows = [
  { id: 'pref-automatic', label: 'Turn Focus on when sharing starts' },
  { id: 'pref-keep', label: 'Keep Focus on after sharing ends' },
  { id: 'pref-notify', label: 'Notify me when Focus changes' },
  { id: 'pref-login', label: 'Launch at login' },
]

const statRows = [
  { id: 'stat-sessions', label: 'Sessions' },
  { id: 'stat-total', label: 'Total quiet time' },
  { id: 'stat-average', label: 'Average session' },
]
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ appName }}</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f6f6f7;
      --panel: #ffffff;
      --text: #16161a;
      --muted: #6b6b76;
      --line: #e3e3e8;
      --accent: #4f46e5;
      --live: #16a34a;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #16161a;
        --panel: #1e1e24;
        --text: #f4f4f6;
        --muted: #9c9caa;
        --line: #2d2d36;
        --accent: #818cf8;
        --live: #4ade80;
      }
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 14px;
      width: 340px;
      font: 13px/1.45 -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    h1 { font-size: 15px; margin: 0; letter-spacing: -0.01em; }
    p { margin: 0; }

    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 10px;
    }

    .row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      min-height: 26px;
    }

    .row + .row { border-top: 1px solid var(--line); margin-top: 6px; padding-top: 6px; }

    .muted { color: var(--muted); }
    .tabular { font-variant-numeric: tabular-nums; }

    /* The status dot is the whole point of the popover: it should be
       readable before any text is. */
    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--muted);
      flex: none;
    }

    #app[data-sharing="true"] .dot { background: var(--live); }

    #app[data-sharing="true"] .dot::after {
      content: '';
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: inherit;
      animation: pulse 2s ease-out infinite;
    }

    @keyframes pulse {
      from { transform: scale(1); opacity: 0.7; }
      to { transform: scale(2.6); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .dot::after { animation: none; }
    }

    .status-line { display: flex; align-items: center; gap: 8px; }

    #sources {
      margin: 8px 0 0;
      font-size: 11px;
      color: var(--muted);
      white-space: pre-line;
      word-break: break-word;
    }

    label { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 10px; cursor: pointer; }
    input[type="checkbox"] { accent-color: var(--accent); flex: none; margin: 0; }

    #setup { border-color: var(--accent); }
    #setup ol { margin: 8px 0 0; padding-left: 18px; color: var(--muted); font-size: 12px; }
    #setup li + li { margin-top: 4px; }

    button {
      font: inherit;
      color: var(--accent);
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
    }

    button:hover { text-decoration: underline; }

    footer { display: flex; justify-content: space-between; align-items: center; padding: 0 2px; }
  </style>
</head>
<body>
  <div id="app" data-sharing="false" data-engaged="false">
    <header class="panel">
      <div class="row">
        <h1>{{ appName }}</h1>
        <span id="focus-state" class="muted">Focus is off</span>
      </div>
      <div class="status-line" style="margin-top: 8px;">
        <span class="dot"></span>
        <p id="status">Checking…</p>
      </div>
      <p id="sources" hidden></p>
    </header>

    <section class="panel" id="setup" hidden>
      <div class="row">
        <strong>Finish setup</strong>
        <button type="button" id="recheck-shortcuts">Re-check</button>
      </div>
      <p class="muted" style="margin-top: 6px; font-size: 12px;">
        macOS only lets Shortcuts change Focus, so {{ appName }} needs two shortcuts to drive it.
      </p>
      <ol>
        @foreach (setupSteps as step)
          <li>{{ step }}</li>
        @endforeach
      </ol>
    </section>

    <section class="panel" id="recording" hidden>
      <div class="row">
        <strong>Allow Screen Recording</strong>
        <button type="button" id="grant-recording">Open Settings</button>
      </div>
      <p class="muted" style="margin-top: 6px; font-size: 12px;">
        macOS only reveals window titles to apps with this permission, and titles are how
        {{ appName }} spots a Zoom or Meet share. Without it, only macOS Screen Sharing is detected.
      </p>
    </section>

    <section class="panel">
      <div class="row">
        <label for="toggle-focus">
          <span>Focus</span>
          <input type="checkbox" id="toggle-focus">
        </label>
      </div>
      @foreach (preferenceRows as pref)
        <div class="row">
          <label for="{{ pref.id }}">
            <span>{{ pref.label }}</span>
            <input type="checkbox" id="{{ pref.id }}">
          </label>
        </div>
      @endforeach
    </section>

    <section class="panel">
      @foreach (statRows as stat)
        <div class="row">
          <span class="muted">{{ stat.label }}</span>
          <span id="{{ stat.id }}" class="tabular">—</span>
        </div>
      @endforeach
    </section>

    <footer>
      <span class="muted">{{ tagline }}</span>
      <button type="button" id="quit">Quit</button>
    </footer>
  </div>

  <script client>
    import './client/main'
  </script>
</body>
</html>
